# SWAG/nginx basic-auth credentials for the ongehoord preview gate.
# Copy to .env, fill in, then bake into the SWAG htpasswd file (see README).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ---------------------------------------------------------------------------
# App runtime secrets do NOT belong here. They live in ~/nas/.env.ongehoord
# and are injected into the container via the compose `env_file:` directive.
# The app (Nuxt) reads these NUXT_* vars at runtime:
#   NUXT_PUBLIC_TOKEN_GOOGLE_MAPS, NUXT_GOOGLE_MAPS_SECRET,
#   NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID, NUXT_HUB_PROJECT_KEY,
#   NUXT_VIMEO_CLIENT_IDENTIFIER, NUXT_VIMEO_ACCESS_TOKEN,
#   NUXT_VIMEO_CLIENT_SECRET, NUXT_MAILERSEND_API_KEY, NUXT_OPENAI_API_KEY
# ---------------------------------------------------------------------------
