# Required
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=replace-me

# (No APP_USERNAME / APP_PASSWORD / APP_BEARER_TOKEN. The app's own session
# login and its bearer gate were removed on 2026-09-04: the public route is
# gated by the single tinyauth door at SWAG and there is one credential for the
# whole surface. ADR-0034. `make check` asserts they do not come back.)

# Optional — enables the AI "Discover" tab (GPT-suggested albums). When unset,
# the tab is hidden. OPENAI_MODEL defaults to gpt-4o.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional — enables the "Spotify" tab (queue albums from your playlists).
# Create an app at https://developer.spotify.com/dashboard, then register the
# redirect URI below (must match SPOTIFY_REDIRECT_URI exactly). All three are
# required to enable the tab.
SPOTIFY_API_CLIENT_ID=
SPOTIFY_API_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://lidarr-bulk.example.com/api/spotify/callback

# Optional — enables the per-playlist "Recreate in Jellyfin" button: matches a
# playlist's tracks against your Jellyfin music library (title + artist) and
# pushes a playlist, skipping tracks not in the library. All three required.
# Reuses the nas stack's Jellyfin API key + user id.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

CONFIG_DIR=/config
RATE_LIMIT_PER_MINUTE=300
BODY_LIMIT_BYTES=262144
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
