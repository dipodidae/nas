# --- the daily digest (ADR-0033) ---
# 09:00 -- ONE markdown message to nas-infra, replacing every routine push the
# six-lane split deliberately stopped sending: successful cron runs, */5 sweeps
# that changed nothing, enforcer runs with no drift. It reports STATE, not
# events, so a digest that arrives late is still correct.
#
# It also reports how many notifications the cooldowns swallowed. That number is
# what keeps the whole scheme honest: zero every day means the windows are too
# short to be doing anything, and a huge number means something is flapping.
# Without it, "quiet" and "broken" are indistinguishable from a phone.
#
# --ok-codes 0,1 (the default) is right here: exit 1 means a section could not
# be collected, which is a gap in the digest and not a failed job.
0 9 * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name notify-digest --max-age-min 1560 -- python scripts/notify_digest.py >> logs/notify_digest.log 2>&1"

# --- stack watchdog: the thing that shouts (docs/jellyfin-playback-audit.md) ---
# Every 5 min — container health/exit/missing/flapping across the whole compose
# stack, Jellyfin anon-RSS threshold (from the per-minute sampler's log), and
# kernel OOM kills from journalctl -k. Pushes to the self-hosted ntfy at
# ntfy.<PUBLIC_DOMAIN>/nas-alerts. Alerts de-duplicate via logs/stack_watchdog.json
# and re-notify hourly while still active; recoveries are announced too.
# Exit 1 just means "an alert is active", so cron mail stays quiet — the push is
# the delivery path, the log is the record.
*/5 * * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name stack-watchdog --lock /tmp/nas-stack-watchdog.lock --max-age-min 30 -- python scripts/stack_watchdog.py >> logs/stack_watchdog.log 2>&1"

# --- Jellyfin per-library scans (docs/jellyfin-playback-audit.md) ---
# Replaces Jellyfin's global "Scan Media Library" scheduled task, whose trigger
# list is now empty (it ran all three libraries every 12h). A library scan is the
# largest memory event on this box — ~1.56GB peak anon-RSS — and Jellyfin's own
# scan task is global-only, so scripts/jellyfin_library_scan.py drives the
# per-library refresh endpoint instead and each library gets its own cadence.
# All three *arr apps now genuinely refresh Jellyfin on import (verified 2026-09-01
# by capturing the inbound POST; Sonarr/Radarr via their own mapFrom/mapTo, Lidarr
# via scripts/lidarr_jellyfin_bridge.py), so these weekly passes are safety nets
# for anything that lands on disk outside an *arr — not the primary path.
# One library per day so two big scans never overlap.
# Fri 05:05 — Movies.
5 5 * * 5 /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name jellyfin-scan-movies --max-age-min 10380 -- python scripts/jellyfin_library_scan.py --library Movies >> logs/jellyfin_library_scan.log 2>&1"
# Sat 05:05 — TV Shows.
5 5 * * 6 /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name jellyfin-scan-tv --max-age-min 10380 -- python scripts/jellyfin_library_scan.py --library 'TV Shows' >> logs/jellyfin_library_scan.log 2>&1"
# Sun 05:05 — Music. Deliberately *after* the 04:45 album_art.py cover backfill:
# sacad writes folder.jpg straight to disk, which Lidarr never sees and therefore
# never reports, so this scan is what actually gets new cover art into Jellyfin.
5 5 * * 0 /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name jellyfin-scan-music --max-age-min 10380 -- python scripts/jellyfin_library_scan.py --library Music >> logs/jellyfin_library_scan.log 2>&1"

# --- whole-library sweep: the only check that sees "on disk and nowhere else" ---
# Sun 06:05 -- after the 05:05 Music library scan, so the scan has had an hour to
# settle anything it was going to add. Walks BOTH directions: disk->Jellyfin
# catches albums with no item (the Kraftwerk class), Jellyfin->disk catches
# ghosts on dead paths. A one-directional sweep cannot see the other fault.
# --ok-codes 0 deliberately: any discrepancy is worth a human, and the wrapper's
# 0,1 default would swallow one. The script has no exit 1 for the same reason.
5 6 * * 0 /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name music-library-sweep --lock /tmp/nas-music-sweep.lock --max-age-min 10380 --ok-codes 0 -- python scripts/music_library_sweep.py >> logs/music_library_sweep.log 2>&1"

# --- Lidarr -> Jellyfin path-mapping bridge (docs/jellyfin-playback-audit.md) ---
# Lidarr's own "Update Library" connection reaches Jellyfin and returns 204 but is
# a silent no-op: it reports /music/... paths, Jellyfin's library is /data/movies/
# music/..., and unmatched paths are dropped without a log line. Sonarr and Radarr
# have mapFrom/mapTo fields for this; Lidarr's connection does not expose them, so
# the mapping lives here. Offset from the watchdog's */5 so they don't collide.
2-59/5 * * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name lidarr-jellyfin-bridge --lock /tmp/nas-lidarr-jf-bridge.lock --max-age-min 30 -- python scripts/lidarr_jellyfin_bridge.py >> logs/lidarr_jellyfin_bridge.log 2>&1"
