*/10 * * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name heartbeat --max-age-min 40 -- python scripts/heartbeat.py >> logs/heartbeat.log 2>&1"
# */5 — re-assert qBittorrent's settings. Runs at the watchdog's cadence, not
# hourly, because it is now also the degraded-mode switch: if the CAKE shaper is
# missing it drops the upload cap 25 -> 15 Mbps, and an hour of unmanaged uplink
# is an hour of 5% packet loss. The upload cap is not cosmetic:
# set above the link's real upstream it fills the modem queue and costs 5% packet
# loss, which is what made remote Jellyfin playback stutter for weeks. The live
# value was observed drifting back to UNLIMITED on 2026-09-02 with the repo pin
# untouched, so pinning it in DESIRED_PREFS is necessary but not sufficient --
# something has to re-assert it. Idempotent: a correct stack logs "none".
*/5 * * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name qbit-settings-enforce --lock /tmp/nas-qbit-enforce.lock --max-age-min 30 -- python scripts/qbittorrent_settings_enforce.py >> logs/qbittorrent_settings_enforce.log 2>&1"
