# durable on its own: tc state is lost whenever the link goes down, and the
# iptables rules reference container IPs that Docker reassigns on recreate.
# Idempotent (apply tears down and rebuilds). systemd covers boot; this covers
# everything after it.
17 * * * * /usr/bin/env bash -c "cd /home/tom/nas && . .venv/bin/activate && python scripts/cron_job.py --name wan-shaper --lock /tmp/nas-wan-shaper.lock --max-age-min 180 -- sudo -n /home/tom/nas/scripts/wan_shaper.sh apply >> logs/wan_shaper.log 2>&1"
