# ============================================================================
# NAS stack environment. Copy to .env and fill in. NEVER commit .env.
#
#   REQUIRED  -- compose fails or a service misbehaves without it
#   OPTIONAL  -- has a `:-default` in the compose files, or gates a feature
#                that hides itself when unset
#   SCRIPTS   -- not read by any container; used only by scripts/ on the host
#
# Cross-checked against the split compose files (compose.yaml, compose/*.yaml,
# webapps/*/compose.yaml): 41 distinct variables are referenced there, and all
# 41 appear below. `make check` asserts the container-side invariants; this
# file is the contract for the values themselves.
#
# Two distinct concerns live here on purpose (see AGENTS.md): values consumed
# by the compose files, and API_KEY_* / NAS_* tokens used only by scripts/.
# Adding a script that needs a new key means documenting it here AND in
# AGENTS.md's env list.
# ============================================================================

# ---------------------------------------------------------------------------
# Host identity and paths
# ---------------------------------------------------------------------------

# REQUIRED. Owner uid/gid for every service that honours PUID/PGID, and the
# `user:` for the three that do not (slskd, qui, ntfy).
# Compose defaults these to 1000, but set them explicitly.
PUID=1000
PGID=1000

# OPTIONAL (defaults to UTC). Container-local timezone.
TZ=Europe/Amsterdam

# REQUIRED. Per-service config root: every service stores state at
# ${CONFIG_DIRECTORY}/<service>. Deliberately a bind mount, not a named
# volume -- scripts/config_backup.py and the cron jobs read these trees
# directly. See docs/decisions/0000-compose-layout.md.
CONFIG_DIRECTORY=/mnt/drive/.docker-config

# REQUIRED. Media + downloads root. Subfolders are LOWERCASE: movies/, series/,
# music/, downloads/, books/, playlists/, nextcloud-data/. On this host an ext4
# mount. Also mounted whole at /data by sonarr/radarr/lidarr/bazarr --
# see docs/decisions/0002-single-mount-data-hardlinks.md.
SHARE_DIRECTORY=/mnt/drive

# ---------------------------------------------------------------------------
# Public surface: SWAG, TLS, domains
# ---------------------------------------------------------------------------

# REQUIRED. Apex domain. Every service is published at <service>.${PUBLIC_DOMAIN}.
PUBLIC_DOMAIN=4eva.me

# REQUIRED. Let's Encrypt registration address; also ntfy's VAPID contact.
ADMIN_EMAIL=admin@4eva.me

# REQUIRED. Cloudflare token for SWAG's DNS-01 wildcard validation.
# Needs Zone:DNS:Edit on the zone only -- not a global API key.
CLOUDFLARE_API_TOKEN=your-cloudflare-scoped-dns-token

# REQUIRED. What Jellyfin advertises to clients.
JELLYFIN_PUBLISHED_URL=https://jellyfin.${PUBLIC_DOMAIN}

# ---------------------------------------------------------------------------
# Auto-update
# ---------------------------------------------------------------------------

# OPTIONAL (defaults to `0 0 4 * * *`, daily 04:00). 6-field cron.
# Only affects containers carrying the watchtower enable label -- qbittorrent,
# jellyfin, the control plane and every locally-built image are deliberately
# opted out. docs/decisions/0006-watchtower-opt-outs.md

# ---------------------------------------------------------------------------
# qBittorrent
# ---------------------------------------------------------------------------

# SCRIPTS ONLY, and deliberately so. The LSIO image never read these
# (linuxserver/docker-qbittorrent#228, closed as not planned) and passing them
# to the container only leaked them into `docker inspect`. `make check`
# asserts they are NOT set on the container.
# Used by: qbittorrent_settings_enforce.py, qbittorrent_stalled_kickstart.py,
# slskd_incomplete_sweep.py, qbit_cleanup_plan.py, media_ops_status.py.
# qui needs them too, but they are typed into qui's own UI once, not passed as
# env. docs/decisions/0011-qbittorrent-credentials.md
QBITTORRENT_USER=admin
QBITTORRENT_PASS=change-this-password

# ---------------------------------------------------------------------------
# qui -- web UI over qBittorrent
# ---------------------------------------------------------------------------

# REQUIRED. Pin it so restarts don't invalidate logins.
#   openssl rand -hex 32
QUI_SESSION_SECRET=change-this-to-a-random-hex-string

# ---------------------------------------------------------------------------
# slskd -- Soulseek
# ---------------------------------------------------------------------------

# REQUIRED. Soulseek network credentials.
# NOTE: a fast restart leaves a "ghost session" on slsknet and logins then time
# out at 5000ms forever. The cure is staying DOWN 15-30 min, never a restart.
# docs/decisions/0009-slskd-healthcheck.md
SLSKD_SLSK_USERNAME=your-soulseek-username
SLSKD_SLSK_PASSWORD=your-soulseek-password

# REQUIRED. slskd's own WebUI login.
SLSKD_USERNAME=admin
SLSKD_PASSWORD=change-this-password

# REQUIRED. slskd administrator API key. Read by the container AND by
# scripts/slskd_login_watch.py, slskd_incomplete_sweep.py, slskd_rescan.py.
API_KEY_SLSKD=your-slskd-api-key

# ---------------------------------------------------------------------------
# *arr API keys
# ---------------------------------------------------------------------------

# REQUIRED (container). Read by lidarr-bulk.
API_KEY_LIDARR=your-lidarr-api-key

# SCRIPTS. Found in each app's Settings -> General.
API_KEY_SONARR=your-sonarr-api-key
API_KEY_RADARR=your-radarr-api-key
API_KEY_PROWLARR=your-prowlarr-api-key
API_KEY_CLEANUPARR=your-cleanuparr-api-key

# ---------------------------------------------------------------------------
# Jellyfin API keys -- these two are NOT interchangeable
# ---------------------------------------------------------------------------

# REQUIRED (container). Jellyseerr's key, reused by lidarr-bulk and
# playlist-generator for their "push to Jellyfin" features.
API_KEY_JELLYFIN=your-jellyfin-api-key

# SCRIPTS + *arr connections. The dedicated `arr-integrations` key used ONLY by
# the Sonarr/Radarr/Lidarr "Update Library" connections, so it can be revoked
# without breaking anything else. Mixing this up with API_KEY_JELLYFIN above is
# a documented trap. docs/decisions/0016-jellyfin-paths-are-load-bearing.md
API_KEY_JELLYFIN_ARR=your-arr-integration-jellyfin-api-key

# REQUIRED (container). Target user for playlist pushes. Find it with:
#   curl -H "X-Emby-Token: $API_KEY_JELLYFIN" http://jellyfin:8096/Users
JELLYFIN_USER_ID=your-jellyfin-user-id

# ---------------------------------------------------------------------------
# lidarr-bulk (webapps/lidarr-bulk)
# ---------------------------------------------------------------------------

# OPTIONAL. With BOTH set, the UI requires login and /api/* requires a session
# cookie or bearer token. Unset = no auth at the app layer.
LIDARR_BULK_USERNAME=admin
LIDARR_BULK_PASSWORD=change-this-password

# OPTIONAL. Bearer-token gate on /api/* for programmatic clients.
LIDARR_BULK_BEARER_TOKEN=

# OPTIONAL (defaults to gpt-4o). Model for the AI "Discover" tab.
LIDARR_BULK_OPENAI_MODEL=gpt-4o

# OPTIONAL. Enables the "Spotify" tab (queue albums from your playlists).
# BOTH required or the tab hides itself.
SPOTIFY_API_CLIENT_ID=
SPOTIFY_API_CLIENT_SECRET=

# OPTIONAL (defaults to https://lidarr-bulk.${PUBLIC_DOMAIN}/api/spotify/callback).
# Override only if the derived URL is not what you registered in the Spotify
# app dashboard -- it must match there exactly.
SPOTIFY_REDIRECT_URI=

# ---------------------------------------------------------------------------
# playlist-generator (webapps/jellyfin-playlist-generator submodule)
# ---------------------------------------------------------------------------

# OPTIONAL (defaults to `admin`) / REQUIRED. nginx basic auth in front of the
# app; /health is the only unauthenticated path.
PLAYLIST_GENERATOR_USERNAME=admin
PLAYLIST_GENERATOR_PASSWORD=change-this-password

# REQUIRED. Postgres password. Also embedded in the app's DATABASE_URL, so
# changing it means recreating both services. Data lives at
# ${CONFIG_DIRECTORY}/playlist-generator-db.
PLAYLIST_GENERATOR_DB_PASSWORD=change-this-db-password

# OPTIONAL (defaults to 8). Library scan concurrency.
PLAYLIST_GENERATOR_SCAN_THREADS=8

# OPTIONAL. Enrichment sources. Last.fm is the one that materially improves
# results; the rest are additive. Shared with lidarr-bulk's Discover tab.
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_API_SECRET=
OPENAI_API_KEY=your-openai-api-key

# OPTIONAL. Either a personal access token OR a consumer key/secret pair.
DISCOGS_TOKEN=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# OPTIONAL but strongly advised: the MusicBrainz API ToS requires a contact
# address, and without it MB rate-limits or blocks ID resolution.
MUSICBRAINZ_CONTACT=your-email@example.com

# ---------------------------------------------------------------------------
# ntfy -- push alerting
# ---------------------------------------------------------------------------
# ntfy runs auth-default-access=deny-all, so every account below needs explicit
# grants. Accounts are created by hand (signup is off). First-time setup:
#   make bootstrap        # pre-chowns ${CONFIG_DIRECTORY}/ntfy -- required
#   docker compose up -d ntfy
#   NTFY_PASSWORD=... docker exec -e NTFY_PASSWORD -i ntfy ntfy user add --role=user watchdog
#   docker exec ntfy ntfy access watchdog nas-alerts rw
# docs/decisions/0012-ntfy-alerting.md

# REQUIRED (container). Publisher account for the *containers*
# (watchtower's shoutrrr digest, and the *arr connections). Write-only.
# Separate trust domain from the host scripts' account, so it can be revoked
# independently.
NTFY_ARR_USER=arr
NTFY_ARR_PASSWORD=change-this-password

# REQUIRED (container). Web Push, so a browser can notify with no ntfy tab
# open. Generate once:  docker exec ntfy ntfy webpush keys
# REGENERATING INVALIDATES EVERY EXISTING BROWSER SUBSCRIPTION. The public key
# is not secret; the private key is. Android does not use any of this.
# ntfy ACCESS TOKEN for Diun (SCRIPTS/CONTAINER — required if diun is running).
# Diun's native ntfy notifier accepts a token ONLY, not basic auth — so it can
# use neither the ?auth= query trick nor user:pass@ URL userinfo. Mint one for
# the existing write-only `arr` publisher, so it inherits that ACL and can be
# revoked without rotating a password six containers share:
#   docker exec ntfy ntfy token add --label "diun (update notifications)" arr
#   docker exec ntfy ntfy token remove arr <token>
# See docs/decisions/0024-diun-version-aware-notification.md
NTFY_DIUN_TOKEN=

NTFY_WEB_PUSH_PUBLIC_KEY=generate-with-ntfy-webpush-keys
NTFY_WEB_PUSH_PRIVATE_KEY=generate-with-ntfy-webpush-keys

# SCRIPTS. Publisher account for the host scripts (stack_watchdog.py,
# cron_job.py, slskd_login_watch.py). Publishes over loopback, so alert
# contents never leave the box. Write-only.
NAS_ALERT_WEBHOOK=http://localhost:8410/nas-alerts
NAS_ALERT_USER=watchdog
NAS_ALERT_PASSWORD=change-this-password

# SCRIPTS/ADMIN. The ntfy server admin, for creating accounts and grants.
NTFY_ADMIN_USER=admin
NTFY_ADMIN_PASSWORD=change-this-password

# SCRIPTS/ADMIN. The subscriber account the phone logs in with. The only
# account with READ access on the alert topics.
NTFY_PHONE_USER=phone
NTFY_PHONE_PASSWORD=change-this-password

# ---------------------------------------------------------------------------
# Off-box dead-man's switch (scripts/heartbeat.py)
# ---------------------------------------------------------------------------
# stack_watchdog and ntfy both run ON this host, so neither can report that the
# host itself is down -- a deliberate, documented coverage limit. Create a
# check at https://healthchecks.io (free tier), period 10 min / grace 20 min,
# and paste its ping URL here. Until it is set, stack_watchdog raises a
# standing `heartbeat:unconfigured` warning.
NAS_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# ---------------------------------------------------------------------------
# Legacy / narrow-use. Kept because something still reads them.
# ---------------------------------------------------------------------------

# SCRIPTS. Read only by scripts/enable_bazarr_plex.py. There is no Plex server
# in this stack; the script is a leftover from a Plex-era setup. Safe to drop
# together with that script.
PLEX_TOKEN=your-plex-token

# ---------------------------------------------------------------------------
# Off-box config backup (scripts/offsite_backup.sh, `make backup-offsite`)
# ---------------------------------------------------------------------------
# config_backup.py writes to /mnt/drive/backups/ -- same host, and for
# ${CONFIG_DIRECTORY} on the OS NVMe not even a different failure domain. This
# pushes the newest of those archives off the box with restic.
#
# For Backblaze B2 use the S3-COMPATIBLE endpoint and S3 credentials rather than
# the native b2: backend -- restic's own docs recommend it. Note the S3 backend
# HIDES obsolete files rather than deleting them, so add a bucket lifecycle rule
# ("keep only the last version") or `forget --prune` leaves hidden objects
# accruing cost forever.
#   s3:s3.<region>.backblazeb2.com/<bucket>
#   sftp:user@otherbox:/backups/nas
RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/your-bucket
# A 0600 FILE holding the passphrase, not the passphrase itself: losing it makes
# every snapshot unreadable, so it does not belong in the same file as
# everything else -- and a copy must live off this machine too.
#   mkdir -p ~/.config/restic
#   openssl rand -base64 48 > ~/.config/restic/nas.pass && chmod 600 ~/.config/restic/nas.pass
RESTIC_PASSWORD_FILE=/home/tom/.config/restic/nas.pass
AWS_ACCESS_KEY_ID=your-b2-key-id
AWS_SECRET_ACCESS_KEY=your-b2-application-key

# ---------------------------------------------------------------------------
# NOT USED ANYWHERE -- do not add these back
# ---------------------------------------------------------------------------
# The following have been REMOVED from .env (2026-09-02) after `git grep` proved
# each is referenced by no compose file and no script. Listed here so their
# absence is a decision, not an oversight:
#
#   API_KEY_BAZARR            bazarr's API is never called by scripts/
#   API_KEY_LAZYLIBRARIAN     lazylibrarian is not in this stack
#   DEEPL_API_KEY             Lingarr's translation key is set in its own UI,
#                             not via env
#   JELLYFIN_CACHE_DIRECTORY  jellyfin's cache stays inside /config
#   OVERSEERR_PUBLISHED_URL   replaced by jellyseerr, which derives its own URL
#   PLEX_IDENTIFIER           Plex-era leftovers (PLEX_TOKEN above is still
#   PLEX_SERVER_NAME          read by one script)
#   RYM_SCRAPE_ENABLED        RateYourMusic support was fully removed from
#   RYM_SCRAPE_DELAY_MIN      playlist-generator; the code path is gone
#   RYM_SCRAPE_DELAY_MAX
#
# App runtime secrets for `ongehoord` do NOT live here -- they are in
# .env.ongehoord, loaded via env_file (also gitignored).

# Beszel hub<->agent pairing (SCRIPTS/CONTAINER — required if beszel is running).
# BESZEL_KEY is the hub PUBLIC key, which the agent uses to authorise the hub.
# The hub generates its keypair on first start:
#   ssh-keygen -y -f ${CONFIG_DIRECTORY}/beszel/id_ed25519
# BESZEL_ADMIN_* is the hub login. TOKEN is NOT needed: the hub dials the agent.
# See docs/decisions/0028-beszel-trend-lines.md
BESZEL_KEY=
BESZEL_ADMIN_USER=
BESZEL_ADMIN_PASSWORD=

# Streamystats (Jellyfin watch statistics, SCRIPTS/CONTAINER — required if it runs).
# Its database is VectorChord, NOT the pgvector instance playlist-generator uses:
# a different extension, so it cannot be shared. See ADR-0030.
STREAMYSTATS_DB_PASSWORD=
STREAMYSTATS_SESSION_SECRET=
STREAMYSTATS_ENCRYPTION_KEY=
# Dedicated Jellyfin API key, revocable without touching the others.
# Mint with: POST /Auth/Keys?App=streamystats
API_KEY_JELLYFIN_STREAMYSTATS=
