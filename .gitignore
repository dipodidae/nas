.env
.env.ongehoord

# Logs
logs/
*.log
pnpm-debug.log*

# Backup files
*.backup
*.bak
*.old
# timestamped/suffixed variants (foo.yml.bak.20260615-161521) — the bare
# globs above only match files *ending* in .bak/.backup
*.bak.*
*.backup.*

# Nginx cache directory
nginx-cache/

node_modules/
__pycache__

.venv
.ruff_cache

.docker-config/

# VPN configs (contain WireGuard private keys)
vpn-configs/

# never commit env backups (they contain real secrets)
.env.bak*
.env.*.bak*

# ongehoord redeploy build-temp (TMPDIR routed off the quota'd /tmp tmpfs)
.deploy-tmp/

# Credentials that must never be committed. `.sudo-pwd` was sitting untracked
# in the repo root on 2026-09-01 — one `git add -A` away from a sudo password
# in the history.
.sudo-pwd

# local, non-committed compose tweaks (see docs/decisions/0000-compose-layout.md)
compose.override.yaml
compose.override.yml
