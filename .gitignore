.env
.env.ongehoord

# Logs
logs/
*.log
pnpm-debug.log*

# Backup files
*.backup
*.bak
*.old
# timestamped/suffixed variants (foo.yml.bak.20260615-161521) — the bare
# globs above only match files *ending* in .bak/.backup
*.bak.*
*.backup.*

# Nginx cache directory
nginx-cache/

node_modules/
__pycache__

.venv
.ruff_cache

.docker-config/

# VPN configs (contain WireGuard private keys)
vpn-configs/

# never commit env backups (they contain real secrets)
.env.bak*
.env.*.bak*

# ongehoord redeploy build-temp (TMPDIR routed off the quota'd /tmp tmpfs)
.deploy-tmp/

# Credentials that must never be committed. `.sudo-pwd` was sitting untracked
# in the repo root on 2026-09-01 — one `git add -A` away from a sudo password
# in the history.
.sudo-pwd

# local, non-committed compose tweaks (see docs/decisions/0000-compose-layout.md)
compose.override.yaml
compose.override.yml

# Rendered credential files. `secrets/tinyauth-users` is the single credential
# for the whole public surface, rendered from .env by `make tinyauth-users`
# (ADR-0034). The whole directory is ignored, and `make check` asserts nothing
# under it is TRACKED -- gitignoring is necessary and not sufficient, and this
# very file was staged once by a `git add -A` before the entry existed.
secrets/

# Third-party skills installed from the skills.sh registry by `npx skills add`.
# `skills-lock.json` IS committed (it pins source + content hash, so
# `npx skills experimental_install` reproduces them); the vendored copies are
# not. The seven hand-written `nas-*`/`verifying-by-effect`/`hunting-silent-
# failure` skills in the same directory ARE tracked -- they are repo docs
# (CLAUDE.md lists them as authoritative), not dependencies. Listing the
# registry ones individually rather than ignoring `.claude/skills/*/` is
# deliberate: a blanket rule would silently swallow the next hand-written
# skill, which is the exact failure shape `hunting-silent-failure` is about.
# Add a line here whenever you `npx skills add` another one.
.claude/skills/incident-runbook-templates/
.claude/skills/postmortem-writing/
# `npx skills experimental_install` (the restore-from-lock command) vendors into
# `.agents/skills/` rather than `.claude/skills/`, so ignore that root too --
# otherwise a restore leaves an untracked tree one `git add -A` from the history.
.agents/
